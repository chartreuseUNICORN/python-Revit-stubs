{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$esbuild-watch",
      "isBackground": true,
      "label": "npm: watch",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$esbuild",
      "label": "npm: compile",
      "group": "build"
    },
    {
      // The test host loads dist/extension.js (package.json "main"), so bundle it before compiling the tests.
      "type": "npm",
      "script": "build:tests",
      "problemMatcher": "$tsc",
      "label": "npm: build:tests",
      "dependsOn": "npm: compile",
      "group": "build"
    }
  ]
}
